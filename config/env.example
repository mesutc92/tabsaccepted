# KAP Alert
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=mesut.cetin@sayax.com.tr
SMTP_PASSWORD=
SMTP_FROM=mesut.cetin@sayax.com.tr
SMTP_STARTTLS=true
ALERT_TO=mesut.cetin@sayax.com.tr

# 60 = her dakika, 300 = her 5 dakika. Minimum 15.
KAP_POLL_INTERVAL=60
KAP_LOOKBACK_DAYS=1
KAP_FETCH_BODY=true
KAP_DRY_RUN=false
KAP_NOTIFY_ON_START=false
# İlk çalışmada yalnızca son N dakikayı bildir (0 = hiçbirini bildirme, sadece tohumla)
KAP_BACKFILL_MINUTES=0
KAP_DB_PATH=/data/kap.db
# KAP_FILTERS_PATH=config/filters.yaml
