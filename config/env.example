# KAP Alert — Docker / yerel çalıştırma
# 1) cp config/env.example .env
# 2) SMTP_PASSWORD doldurun (Gmail uygulama şifresi)
# 3) docker compose up -d --build

# --- Zorunlu (mail için) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mesutc92@gmail.com
SMTP_PASSWORD=
SMTP_FROM=mesutc92@gmail.com
SMTP_STARTTLS=true
ALERT_TO=mesutc92@gmail.com

# --- Tarama ---
# 60 = her dakika, 300 = her 5 dakika. Minimum 15.
KAP_POLL_INTERVAL=60
KAP_LOOKBACK_DAYS=1
KAP_FETCH_BODY=true

# İlk ayağa kaldırmada geçmişi mailleme.
# true yaparsanız o an listedeki uygun bildirimler hemen gider.
KAP_NOTIFY_ON_START=false
KAP_BACKFILL_MINUTES=0

# Mail atmadan log izlemek için true yapın, sonra false'a çekin.
KAP_DRY_RUN=false

# Docker compose bunları override eder; yerelde venv için:
KAP_DB_PATH=/data/kap.db
